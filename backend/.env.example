MONGODB_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_jwt_secret
PORT=5000
# Optional: enables personalized Gemini suggestions; without it, local starter ideas are shown.
GEMINI_API_KEY=your_google_ai_studio_key
# Optional emergency fallback if model discovery is unavailable.
GEMINI_FALLBACK_MODEL=gemini-flash-latest
